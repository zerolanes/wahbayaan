# ── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty in development to use the embedded PGlite database
# stored in PGLITE_DIR. In production, point it at a real Postgres instance.
DATABASE_URL=
PGLITE_DIR=.data/pglite

# ── App ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Shows seeded demo content (with a visible "demo content" ribbon). Never enable in production.
DEMO_MODE=true
# Where uploaded images are stored when no object storage is configured.
UPLOAD_DIR=uploads

# ── Payments (not configured = test-mode simulator, clearly labelled) ───────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── Exchange rates ──────────────────────────────────────────────────────────
# Provider used by Admin → Rates → "Refresh from provider". Leave empty to manage rates manually.
FX_PROVIDER=open-er-api
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/PKR

# ── Couriers (rate quotes + tracking) — pending contracts ───────────────────
DHL_API_KEY=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
ARAMEX_USERNAME=
ARAMEX_PASSWORD=

# ── Email ───────────────────────────────────────────────────────────────────
# Not configured = emails are written to the admin Email outbox instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Wahbayaan <hello@wahbayaan.com>"

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# Protects /api/cron/* (escrow auto-release hourly, FX refresh daily — see vercel.json).
CRON_SECRET=
